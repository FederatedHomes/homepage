# Development deployment profile
# The local Docker/Compose workflow intentionally uses Flower's insecure transport.
DEPLOYMENT_PROFILE=development

# Host role for Compose generation: all, server, or client.
# Use 'all' for the existing single-host development workflow.
DEPLOYMENT_ROLE=all
# Required only for a client-role deployment.
CLIENT_ID=

# Flower federation compose parameters
SERVER_PORT=8080
SERVER_ADDRESS=server:8080
SUPERLINK_ADDRESS=superlink:9092
BATCH_SIZE=32
DATA_DIR=/app/data
CHECKPOINT_DIR=/app/checkpoints
MODEL_BASE_NAME=final_model.pt
GLOBAL_MODEL_PREFIX=global
CLIENT_MODEL_PREFIX=client
METRICS_BASE_NAME=final_metrics.json
TRAIN_DATA_FILE=train.csv
VAL_DATA_FILE=val.csv
