# Production deployment profile
# Copy to .env on the deployment host. Do not commit the populated .env file.
DEPLOYMENT_PROFILE=production

# Central Flower SuperLink endpoint reachable by SuperNodes.
SUPERLINK_ADDRESS=fl.example.internal:9092

# TLS material paths inside the SuperLink/SuperNode containers.
# The SuperLink receives the full TLS set; SuperNodes receive only ca.crt.
# Private keys must be unique to the service and must never be committed.
TLS_ROOT_CERTIFICATES=/etc/flower/tls/ca.crt
SUPERLINK_CERTIFICATE=/etc/flower/tls/superlink.crt
SUPERLINK_PRIVATE_KEY=/etc/flower/tls/superlink.key
TLS_CERTIFICATE_HOST_DIR=./certificates/prod/tls

# Flower CLI-managed SuperNode authentication.
# Container path for the individual key passed to --auth-supernode-private-key.
SUPERNODE_AUTH_PRIVATE_KEY_DIR=/etc/flower/auth
# Host directory containing one private EC key per authorized SuperNode.
# Each SuperNode container receives only its own key from this directory.
SUPERNODE_AUTH_HOST_DIR=./certificates/prod/auth

# Persistent Flower SuperLink state, including registered SuperNode identities.
# The host directory must survive SuperLink container recreation.
SUPERLINK_STATE_HOST_DIR=./state/superlink
# Writable directory inside the SuperLink container.
SUPERLINK_STATE_DIR=/var/lib/flower

# Application/runtime settings
BATCH_SIZE=32
DATA_DIR=/app/data
CHECKPOINT_DIR=/app/checkpoints
MODEL_BASE_NAME=final_model.pt
GLOBAL_MODEL_PREFIX=global
CLIENT_MODEL_PREFIX=client
METRICS_BASE_NAME=final_metrics.json
TRAIN_DATA_FILE=train.csv
VAL_DATA_FILE=val.csv
